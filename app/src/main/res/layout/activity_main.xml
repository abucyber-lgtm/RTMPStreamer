<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera preview surface, RootEncoder attaches its encoder to this -->
    <com.pedro.library.view.OpenGlView
        android:id="@+id/openGlView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status pill: status teks + timer + bitrate -->
    <LinearLayout
        android:id="@+id/statusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_status_pill"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_idle"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvMonitoring"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="00:00  •  0 kbps  •  0 drop"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Switch camera -->
    <ImageButton
        android:id="@+id/btnSwitchCamera"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="@string/btn_switch_camera"
        android:padding="9dp"
        android:src="@android:drawable/ic_menu_camera"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Toggle text watermark overlay -->
    <ImageButton
        android:id="@+id/btnToggleOverlay"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="Label overlay"
        android:padding="9dp"
        android:src="@android:drawable/ic_menu_edit"
        app:layout_constraintTop_toBottomOf="@id/btnSwitchCamera"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Toggle local recording -->
    <ImageButton
        android:id="@+id/btnToggleRecord"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="Rekam lokal"
        android:padding="9dp"
        android:src="@android:drawable/presence_video_online"
        app:layout_constraintTop_toBottomOf="@id/btnToggleOverlay"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Adaptive bitrate toggle -->
    <ImageButton
        android:id="@+id/btnAdaptiveBitrate"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="Bitrate adaptif"
        android:padding="9dp"
        android:src="@android:drawable/ic_menu_manage"
        app:layout_constraintTop_toBottomOf="@id/btnToggleRecord"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Schedule button -->
    <ImageButton
        android:id="@+id/btnSchedule"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="Jadwal streaming"
        android:padding="9dp"
        android:src="@android:drawable/ic_menu_my_calendar"
        app:layout_constraintTop_toBottomOf="@id/btnAdaptiveBitrate"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom control panel -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_dark"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tujuan RTMP"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnAddProfile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tambah profil RTMP"
                android:src="@android:drawable/ic_input_add"
                app:tint="@color/accent_green" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxHeight="180dp"
            android:nestedScrollingEnabled="true" />

        <TextView
            android:id="@+id/tvNoProfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:padding="12dp"
            android:text="Belum ada tujuan RTMP. Ketuk + untuk menambahkan."
            android:textColor="#888888"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartStop"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="16dp"
            android:backgroundTint="@color/accent_green"
            android:text="@string/btn_start"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
